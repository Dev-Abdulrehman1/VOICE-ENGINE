# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- OpenRouter (get a key at https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App access key: you type this in the UI to unlock the app ---
ACCESS_KEY=change-me-to-a-long-random-string

# --- Optional ---
DATA_DIR=data
REQUEST_TIMEOUT=180
MAX_CHARS=4000
AUDIO_FORMAT=mp3
